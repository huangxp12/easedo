{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodayTrace",
  "version": "0.2.0",
  "identifier": "workbuddy.todaytrace",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TodayTrace",
        "width": 980,
        "height": 700,
        "minWidth": 280,
        "minHeight": 200,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
